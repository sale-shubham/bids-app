# Backend URL — the browser, src/proxy.ts's server-side refresh and the service worker all call it
# DIRECTLY (no /api proxy). Backend serves routes at the root, e.g. /auth/login, /auctions.
# Read through API_ORIGIN (src/constants/api.ts) — never interpolate process.env directly.
# Deployed: the API's custom domain on the app's own site so auth cookies stay first-party,
# and the API's CORS must allow the app origin. Build-time (inlined).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site URL (canonical links, OG tags, sitemap). Placeholder until domains are decided.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Comma-separated origins allowed as next/image remote hosts (CDN + dev backend).
NEXT_PUBLIC_IMAGE_ORIGINS=http://localhost:4000

# Base URL prefixed onto stored object keys (S3/CloudFront) by assetUrl() (src/lib/assets.ts).
NEXT_PUBLIC_UPLOADS_BASE_URL=https://your-cdn.cloudfront.net

# Register the service worker under `next dev` too (default: production only).
# NEXT_PUBLIC_ENABLE_SW=1

# SERVER-ONLY — never prefix with NEXT_PUBLIC. Must equal bids-api's JWT_SECRET. Used only in
# src/proxy.ts (edge, via `jose`) to verify the httpOnly nb_at cookie.
JWT_SECRET=<same value as bids-api JWT_SECRET>
