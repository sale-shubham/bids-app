# ---------------------------------------------------------------------------
# NobleBid web app - environment variables. Copy to .env.local for development.
# Deployed values live in Amplify Console per branch (readme/flows/deployment.md).
# NEXT_PUBLIC_* are inlined at BUILD time (change = rebuild); the rest are server-only.
# ---------------------------------------------------------------------------

# Backend URL the BROWSER uses (axios + service worker). Backend serves routes at the root
# (/auth/login, /auctions ...). Read through src/constants/api.ts - never process.env directly.
#   Custom-domain mode : the API's absolute URL on the app's own site, e.g. https://bidsapi.shubsale.in (live)
#                        (auth cookies stay first-party; the API's CORS must allow the app origin).
#   Proxy mode         : /api   (and set API_PROXY_TARGET below)
# Missing -> build warns and falls back to http://localhost:4000.
NEXT_PUBLIC_API_URL=http://localhost:4000

# SERVER-ONLY, OPTIONAL. Raw API Gateway URL (no trailing slash), e.g.
# https://abc123.execute-api.ap-south-1.amazonaws.com/prod . When set, next.config.ts rewrites
# /api/:path* -> ${API_PROXY_TARGET}/:path* ("no custom domain" mode) and the app must use
# NEXT_PUBLIC_API_URL=/api. Server-side fetches (RSC, src/proxy.ts) use this absolute URL.
# Leave unset in custom-domain mode.
# API_PROXY_TARGET=https://abc123.execute-api.ap-south-1.amazonaws.com/prod

# This app's public URL (canonical links, OG tags, sitemap, robots). No trailing slash.
# Live: https://bidsapp.shubsale.in
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# The marketing website's URL (separate repo, bids-website): the app links out to its About /
# How it works / Contact pages as absolute links. No trailing slash. Read via src/constants/website.ts.
# Live: https://noblebids.shubsale.in (required on the Amplify branch after the restructure is merged)
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# Comma-separated origins allowed as next/image remote hosts (CDN + dev backend), read by next.config.ts.
# https://picsum.photos is DEV ONLY (the demo seed's placeholder images) - drop it in production.
NEXT_PUBLIC_IMAGE_ORIGINS=http://localhost:4000,https://picsum.photos

# Base URL prefixed onto stored object keys (S3/CloudFront) by assetUrl() (src/lib/assets.ts).
NEXT_PUBLIC_UPLOADS_BASE_URL=https://your-cdn.cloudfront.net

# Register the service worker under `next dev` too (default: production only). Needed to try push locally.
# NEXT_PUBLIC_ENABLE_SW=1

# SERVER-ONLY - never prefix with NEXT_PUBLIC. MUST equal bids-api's JWT_SECRET exactly: used only in
# src/proxy.ts (via `jose`) to verify the httpOnly nb_at cookie. A mismatch logs every member out.
JWT_SECRET=<same value as bids-api JWT_SECRET>
